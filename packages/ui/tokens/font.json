{
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["Geist", "system-ui", "sans-serif"],
        "$description": "Geist, SIL Open Font License 1.1, from github.com/vercel/geist-font (also on Google Fonts). The storefront already loads it with next/font; no font files are bundled here."
      }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "heading-1": { "$type": "dimension", "$value": "40px" },
      "heading-2": { "$type": "dimension", "$value": "32px" },
      "heading-3": { "$type": "dimension", "$value": "24px" },
      "heading-4": { "$type": "dimension", "$value": "20px" },
      "body": { "$type": "dimension", "$value": "16px" },
      "small": { "$type": "dimension", "$value": "14px" }
    },
    "line-height": {
      "$description": "Line height for the size of the same name, on the 4px grid.",
      "heading-1": { "$type": "dimension", "$value": "48px" },
      "heading-2": { "$type": "dimension", "$value": "40px" },
      "heading-3": { "$type": "dimension", "$value": "32px" },
      "heading-4": { "$type": "dimension", "$value": "28px" },
      "body": { "$type": "dimension", "$value": "24px" },
      "small": { "$type": "dimension", "$value": "20px" }
    }
  }
}
