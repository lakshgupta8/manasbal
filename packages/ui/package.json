{
  "name": "@manasbal/ui",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "dev": "storybook dev --port 6006 --ci",
    "build": "storybook build --quiet --output-dir storybook-static",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run --coverage",
    "test:visual": "node scripts/visual.mjs",
    "tokens": "style-dictionary build --config style-dictionary.config.ts"
  },
  "dependencies": {
    "@manasbal/icons": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/geist": "5.3.0",
    "@manasbal/tsconfig": "workspace:*",
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.6.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "10.6.7",
    "style-dictionary": "5.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
