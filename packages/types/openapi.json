{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Returns ok, the service name and the running version. Not rate-limited.",
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        },
        "summary": "Check the API is up",
        "tags": ["Health"]
      }
    },
    "/auth/sign-up": {
      "post": {
        "description": "Use made-up details. This is a demo.",
        "operationId": "AuthController_signUp",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 128
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "confirmAdult": {
                    "type": "boolean",
                    "enum": [true]
                  }
                },
                "required": ["email", "password", "name", "confirmAdult"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignUpResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid details, or we could not create this account"
          }
        },
        "summary": "Create an account",
        "tags": ["Auth"]
      }
    },
    "/auth/sign-in": {
      "post": {
        "description": "Answers an access token and sets the refresh_token cookie.",
        "operationId": "AuthController_signIn",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": ["email", "password"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInResult"
                }
              }
            }
          },
          "401": {
            "description": "Email or password is wrong"
          }
        },
        "summary": "Sign in",
        "tags": ["Auth"]
      }
    },
    "/me/addresses": {
      "get": {
        "description": "Every delivery address the demo user has saved, sorted by name.",
        "operationId": "AddressesController_list",
        "parameters": [
          {
            "name": "x-demo-user",
            "in": "header",
            "description": "Id of the user to act as. Outside production only, until sign-in exists. The API client's demoUser option sets it.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Address"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No user, or the API runs in production"
          }
        },
        "summary": "List my addresses",
        "tags": ["Addresses"]
      },
      "post": {
        "description": "Saves a new delivery address for the demo user. The change is written to the audit log.",
        "operationId": "AddressesController_create",
        "parameters": [
          {
            "name": "x-demo-user",
            "in": "header",
            "description": "Id of the user to act as. Outside production only, until sign-in exists. The API client's demoUser option sets it.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "line1": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "city": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "state": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "pincode": {
                    "type": "string",
                    "pattern": "^[1-9]\\d{5}$"
                  },
                  "isDefault": {
                    "type": "boolean"
                  }
                },
                "required": ["name", "line1", "city", "state", "pincode"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Address"
                }
              }
            }
          },
          "401": {
            "description": "No user, or the API runs in production"
          }
        },
        "summary": "Add an address",
        "tags": ["Addresses"]
      }
    },
    "/me/addresses/{id}": {
      "patch": {
        "description": "Updates only the fields sent. The change is written to the audit log.",
        "operationId": "AddressesController_update",
        "parameters": [
          {
            "name": "x-demo-user",
            "in": "header",
            "description": "Id of the user to act as. Outside production only, until sign-in exists. The API client's demoUser option sets it.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "line1": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "city": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "state": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "pincode": {
                    "type": "string",
                    "pattern": "^[1-9]\\d{5}$"
                  },
                  "isDefault": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Address"
                }
              }
            }
          },
          "401": {
            "description": "No user, or the API runs in production"
          },
          "404": {
            "description": "The user has no address with this id"
          }
        },
        "summary": "Change an address",
        "tags": ["Addresses"]
      },
      "delete": {
        "description": "Deletes one of the demo user's addresses. An address an order was sent to cannot be deleted. The change is written to the audit log.",
        "operationId": "AddressesController_remove",
        "parameters": [
          {
            "name": "x-demo-user",
            "in": "header",
            "description": "Id of the user to act as. Outside production only, until sign-in exists. The API client's demoUser option sets it.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "401": {
            "description": "No user, or the API runs in production"
          },
          "404": {
            "description": "The user has no address with this id"
          },
          "409": {
            "description": "An order was sent to this address"
          }
        },
        "summary": "Delete an address",
        "tags": ["Addresses"]
      }
    },
    "/categories": {
      "get": {
        "description": "The whole category tree, each level sorted by name.",
        "operationId": "CategoriesController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          }
        },
        "summary": "List categories",
        "tags": ["Catalog"]
      }
    },
    "/products": {
      "get": {
        "description": "One page of products, optionally in one category. Pass nextCursor to get the next page.",
        "operationId": "ProductsController_list",
        "parameters": [
          {
            "name": "category",
            "required": false,
            "in": "query",
            "description": "Category slug",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "nextCursor from the previous page",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "1 to 100, default 20",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPage"
                }
              }
            }
          },
          "400": {
            "description": "The cursor or limit is not valid"
          }
        },
        "summary": "List products",
        "tags": ["Catalog"]
      }
    },
    "/products/{id}/stock": {
      "get": {
        "description": "How many of each variant of the product are in stock right now.",
        "operationId": "ProductsController_stock",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductStock"
                }
              }
            }
          },
          "400": {
            "description": "The id is not a uuid"
          },
          "404": {
            "description": "No such product"
          }
        },
        "summary": "Get a product's stock",
        "tags": ["Catalog"]
      }
    },
    "/products/{slug}": {
      "get": {
        "description": "A product by its slug, with its category, seller and variants. Prices are whole paise.",
        "operationId": "ProductsController_detail",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDetail"
                }
              }
            }
          },
          "404": {
            "description": "No such product"
          }
        },
        "summary": "Get a product",
        "tags": ["Catalog"]
      }
    },
    "/sellers/{slug}": {
      "get": {
        "description": "An approved seller's store by its slug, with how many products it lists.",
        "operationId": "SellersController_store",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerStore"
                }
              }
            }
          },
          "404": {
            "description": "No such store, or it is not approved yet"
          }
        },
        "summary": "Get a seller's store",
        "tags": ["Sellers"]
      }
    },
    "/products/{slug}/reviews": {
      "get": {
        "description": "One page of reviews for a product. Only the reviewer's first name is shown.",
        "operationId": "ReviewsController_list",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "nextCursor from the previous page",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "1 to 100, default 20",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewPage"
                }
              }
            }
          },
          "400": {
            "description": "The cursor or limit is not valid"
          },
          "404": {
            "description": "No such product"
          }
        },
        "summary": "List a product's reviews",
        "tags": ["Catalog"]
      }
    },
    "/cart": {
      "get": {
        "description": "The demo user's cart with its lines and total, in whole paise.",
        "operationId": "CartController_get",
        "parameters": [
          {
            "name": "x-demo-user",
            "in": "header",
            "description": "Id of the user to act as. Outside production only, until sign-in exists. The API client's demoUser option sets it.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cart"
                }
              }
            }
          },
          "401": {
            "description": "No user, or the API runs in production"
          }
        },
        "summary": "Get my cart",
        "tags": ["Cart"]
      }
    },
    "/cart/items": {
      "post": {
        "description": "Adds a variant to the cart. If it is already there, its quantity goes up. Send an Idempotency-Key header so that retrying the request doesn't add the item twice.",
        "operationId": "CartController_addItem",
        "parameters": [
          {
            "name": "x-demo-user",
            "in": "header",
            "description": "Id of the user to act as. Outside production only, until sign-in exists. The API client's demoUser option sets it.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Repeats of the same key answer the first result instead of adding again",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "variantId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  }
                },
                "required": ["variantId", "quantity"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cart"
                }
              }
            }
          },
          "401": {
            "description": "No user, or the API runs in production"
          },
          "404": {
            "description": "No such variant"
          },
          "409": {
            "description": "More than the stock"
          }
        },
        "summary": "Add to my cart",
        "tags": ["Cart"]
      }
    },
