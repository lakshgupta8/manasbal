          }
        },
        "summary": "Read the audit log",
        "tags": ["Admin"]
      }
    }
  },
  "info": {
    "title": "Manasbal API",
    "description": "HTTP API of the Manasbal storefront",
    "version": "generated",
    "contact": {}
  },
  "tags": [
    {
      "name": "Health",
      "description": "Whether the API is up, and which version is running"
    },
    {
      "name": "Auth",
      "description": "Signing up and signing in"
    },
    {
      "name": "Catalog",
      "description": "Categories, products, stock and reviews"
    },
    {
      "name": "Sellers",
      "description": "Seller storefronts"
    },
    {
      "name": "Cart",
      "description": "The demo user's cart"
    },
    {
      "name": "Orders",
      "description": "The demo user's orders"
    },
    {
      "name": "Addresses",
      "description": "The demo user's delivery addresses"
    },
    {
      "name": "Admin",
      "description": "Admin-only views, such as the audit log"
    }
  ],
  "servers": [
    {
      "url": "/",
      "description": "The server that serves these docs"
    }
  ],
  "components": {
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          },
          "service": {
            "type": "string",
            "enum": ["manasbal-api"]
          },
          "version": {
            "type": "string",
            "example": "dev"
          }
        },
        "required": ["status", "service", "version"]
      },
      "SignUpResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "email", "name"]
      },
      "SignInResult": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "description": "Seconds until the access token expires",
            "example": 900
          }
        },
        "required": ["accessToken", "expiresIn"]
      },
      "Address": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "line1": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "pincode": {
            "type": "string",
            "example": "190006"
          },
          "isDefault": {
            "type": "boolean"
          }
        },
        "required": ["id", "name", "line1", "city", "state", "pincode", "isDefault"]
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            }
          }
        },
        "required": ["id", "name", "slug", "children"]
      },
      "ProductCategory": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["slug", "name"]
      },
      "ProductSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "pricePaise": {
            "type": "integer",
            "nullable": true,
            "description": "The cheapest variant's price in whole paise, or null when there are no variants",
            "example": 49900
          },
          "category": {
            "$ref": "#/components/schemas/ProductCategory"
          }
        },
        "required": ["id", "slug", "name", "pricePaise", "category"]
      },
      "ProductPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductSummary"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
