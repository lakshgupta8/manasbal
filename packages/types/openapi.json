    },
    "/admin/audit-log": {
      "get": {
        "description": "One page of recorded changes, newest first. Only admins can read it.",
        "operationId": "AdminController_list",
        "parameters": [
          {
            "name": "x-demo-user",
            "in": "header",
            "description": "Id of the user to act as. Outside production only, until sign-in exists. The API client's demoUser option sets it.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "required": false,
