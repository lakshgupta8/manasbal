// use prisma-8

// Tables are plural snake_case, because "user" is a reserved word in Postgres.
// is_sample and created_by_visitor mark demo rows, so the nightly reset deletes exactly the right data.

model User {
  id               Uuid     @id @default(uuid())
  email            String   @unique
  passwordHash     String   @map("password_hash")
  name             String
  role             String   @default("buyer")
  isSample         Boolean  @default(false) @map("is_sample")
  createdByVisitor Boolean  @default(false) @map("created_by_visitor")
  createdAt        DateTime @default(now()) @map("created_at")
  seller           Seller?

  @@map("users")
}

model Category {
  id       Uuid       @id @default(uuid())
  parentId Uuid?      @map("parent_id")
  name     String
  slug     String     @unique
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id          Uuid     @id @default(uuid())
  sellerId    Uuid     @map("seller_id")
  categoryId  Uuid     @map("category_id")
  name        String
  slug        String   @unique
  description String?
  isSample    Boolean  @default(false) @map("is_sample")
  createdAt   DateTime @default(now()) @map("created_at")
  seller      Seller   @relation(fields: [sellerId], references: [id])
  category    Category @relation(fields: [categoryId], references: [id])
  variants    Variant[]

  @@map("products")
}

model Seller {
  id        Uuid      @id @default(uuid())
  userId    Uuid      @unique @map("user_id")
  storeName String    @map("store_name")
  slug      String    @unique
  status    String    @default("pending")
  isSample  Boolean   @default(false) @map("is_sample")
  user      User      @relation(fields: [userId], references: [id])
  products  Product[]

  @@map("sellers")
}

model Variant {
  id         Uuid        @id @default(uuid())
  productId  Uuid        @map("product_id")
  sku        String      @unique
  size       String?
  colour     String?
  pricePaise Int         @map("price_paise")
  product    Product     @relation(fields: [productId], references: [id])
  inventory  Inventory[]

  @@map("variants")
}

model Inventory {
  id        Uuid    @id @default(uuid())
  variantId Uuid    @map("variant_id")
  location  String
  quantity  Int     @default(0)
  reserved  Int     @default(0)
  variant   Variant @relation(fields: [variantId], references: [id])

  @@map("inventory")
}
