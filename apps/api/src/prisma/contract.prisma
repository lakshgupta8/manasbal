// use prisma-8

// Tables are plural snake_case, because "user" is a reserved word in Postgres.
// is_sample and created_by_visitor mark demo rows, so the nightly reset deletes exactly the right data.

model User {
  id               Uuid     @id @default(uuid())
  email            String   @unique
  passwordHash     String   @map("password_hash")
  name             String
  role             String   @default("buyer")
  isSample         Boolean  @default(false) @map("is_sample")
  createdByVisitor Boolean  @default(false) @map("created_by_visitor")
  createdAt        DateTime @default(now()) @map("created_at")
  seller           Seller?
  addresses        Address[]
  orders           Order[]
  reviews          Review[]
  auditLogs        AuditLog[]

  @@map("users")
}

model Category {
  id       Uuid       @id @default(uuid())
  parentId Uuid?      @map("parent_id")
  name     String
  slug     String     @unique
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id          Uuid     @id @default(uuid())
  sellerId    Uuid     @map("seller_id")
  categoryId  Uuid     @map("category_id")
  name        String
  slug        String   @unique
  description String?
  isSample    Boolean  @default(false) @map("is_sample")
  createdAt   DateTime @default(now()) @map("created_at")
  seller      Seller   @relation(fields: [sellerId], references: [id])
  category    Category @relation(fields: [categoryId], references: [id])
  variants    Variant[]
  reviews     Review[]

  @@map("products")
}

model Seller {
  id        Uuid      @id @default(uuid())
  userId    Uuid      @unique @map("user_id")
  storeName String    @map("store_name")
  slug      String    @unique
  status    String    @default("pending")
  isSample  Boolean   @default(false) @map("is_sample")
  user      User      @relation(fields: [userId], references: [id])
  products  Product[]
  subOrders SubOrder[]

  @@map("sellers")
}

model Variant {
  id         Uuid        @id @default(uuid())
  productId  Uuid        @map("product_id")
  sku        String      @unique
  size       String?
  colour     String?
  pricePaise Int         @map("price_paise")
  product    Product     @relation(fields: [productId], references: [id])
  inventory  Inventory[]
  orderItems OrderItem[]

  @@map("variants")
}

model Inventory {
  id        Uuid    @id @default(uuid())
  variantId Uuid    @map("variant_id")
  location  String
  quantity  Int     @default(0)
  reserved  Int     @default(0)
  variant   Variant @relation(fields: [variantId], references: [id])

  @@map("inventory")
}

model Address {
  id               Uuid    @id @default(uuid())
  userId           Uuid    @map("user_id")
  name             String
  line1            String
  city             String
  state            String
  pincode          String
  phone            String
  isDefault        Boolean @default(false) @map("is_default")
  createdByVisitor Boolean @default(false) @map("created_by_visitor")
  user             User    @relation(fields: [userId], references: [id])
  orders           Order[]

  @@map("addresses")
}

model Coupon {
  id             Uuid     @id @default(uuid())
  code           String   @unique
  percentOff     Int?     @map("percent_off")
  amountOffPaise Int?     @map("amount_off_paise")
  validUntil     DateTime @map("valid_until")
  orders         Order[]

  @@map("coupons")
}

model Order {
  id               Uuid       @id @default(uuid())
  userId           Uuid       @map("user_id")
  addressId        Uuid       @map("address_id")
  couponId         Uuid?      @map("coupon_id")
  status           String
  totalPaise       Int        @map("total_paise")
  idempotencyKey   String     @unique @map("idempotency_key")
  createdByVisitor Boolean    @default(false) @map("created_by_visitor")
  createdAt        DateTime   @default(now()) @map("created_at")
  user             User       @relation(fields: [userId], references: [id])
  address          Address    @relation(fields: [addressId], references: [id])
  coupon           Coupon?    @relation(fields: [couponId], references: [id])
  subOrders        SubOrder[]
  payment          Payment?

  @@map("orders")
}

model SubOrder {
  id            Uuid        @id @default(uuid())
  orderId       Uuid        @map("order_id")
  sellerId      Uuid        @map("seller_id")
  status        String
  subtotalPaise Int         @map("subtotal_paise")
  order         Order       @relation(fields: [orderId], references: [id])
  seller        Seller      @relation(fields: [sellerId], references: [id])
  items         OrderItem[]

  @@map("sub_orders")
}

model OrderItem {
  id             Uuid     @id @default(uuid())
  subOrderId     Uuid     @map("sub_order_id")
  variantId      Uuid     @map("variant_id")
  quantity       Int
  unitPricePaise Int      @map("unit_price_paise")
  subOrder       SubOrder @relation(fields: [subOrderId], references: [id])
  variant        Variant  @relation(fields: [variantId], references: [id])
  review         Review?

  @@map("order_items")
}

model Payment {
  id          Uuid     @id @default(uuid())
  orderId     Uuid     @unique @map("order_id")
  status      String
  amountPaise Int      @map("amount_paise")
  gatewayRef  String   @map("gateway_ref")
  createdAt   DateTime @default(now()) @map("created_at")
  order       Order    @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Review {
  id               Uuid      @id @default(uuid())
  orderItemId      Uuid      @unique @map("order_item_id")
  userId           Uuid      @map("user_id")
  productId        Uuid      @map("product_id")
  rating           Int
  body             String
  isSample         Boolean   @default(false) @map("is_sample")
  createdByVisitor Boolean   @default(false) @map("created_by_visitor")
  orderItem        OrderItem @relation(fields: [orderItemId], references: [id])
  user             User      @relation(fields: [userId], references: [id])
  product          Product   @relation(fields: [productId], references: [id])

  @@map("reviews")
}

model AuditLog {
  id         Uuid     @id @default(uuid())
  actorId    Uuid?    @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   Uuid     @map("target_id")
  requestId  String   @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}
