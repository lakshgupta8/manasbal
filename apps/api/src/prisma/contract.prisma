// use prisma-8

// Tables are plural snake_case, because "user" is a reserved word in Postgres.
// is_sample and created_by_visitor mark demo rows, so the nightly reset deletes exactly the right data.
// Every table a visitor can write to, directly or as a side effect, has both columns; categories and
// coupons have neither, because only the seed or an admin writes them.

model User {
  id               Uuid     @id @default(uuid())
  email            String   @unique
  passwordHash     String   @map("password_hash")
  name             String
  role             String   @default("buyer")
  isSample         Boolean  @default(false) @map("is_sample")
  createdByVisitor Boolean  @default(false) @map("created_by_visitor")
  createdAt        DateTime @default(now()) @map("created_at")
  seller           Seller?
  addresses        Address[]
  orders           Order[]
  reviews          Review[]
  cart             Cart?
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]

  @@map("users")
}

model Category {
  id       Uuid       @id @default(uuid())
  parentId Uuid?      @map("parent_id")
  name     String
  slug     String     @unique
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id          Uuid     @id @default(uuid())
  sellerId    Uuid     @map("seller_id")
  categoryId  Uuid     @map("category_id")
  name        String
  slug        String   @unique
  description String?
  isSample    Boolean  @default(false) @map("is_sample")
  createdByVisitor Boolean @default(false) @map("created_by_visitor")
  createdAt   DateTime @default(now()) @map("created_at")
  seller      Seller   @relation(fields: [sellerId], references: [id])
  category    Category @relation(fields: [categoryId], references: [id])
  variants    Variant[]
  reviews     Review[]

  @@map("products")
}

model Seller {
  id        Uuid      @id @default(uuid())
  userId    Uuid      @unique @map("user_id")
  storeName String    @map("store_name")
  slug      String    @unique
  status    String    @default("pending")
  isSample  Boolean   @default(false) @map("is_sample")
  createdByVisitor Boolean @default(false) @map("created_by_visitor")
  user      User      @relation(fields: [userId], references: [id])
  products  Product[]
  subOrders SubOrder[]
  settlements Settlement[]

  @@map("sellers")
}

model Variant {
  id         Uuid        @id @default(uuid())
  productId  Uuid        @map("product_id")
  sku        String      @unique
  size       String?
  colour     String?
  pricePaise Int         @map("price_paise")
  isSample         Boolean @default(false) @map("is_sample")
  createdByVisitor Boolean @default(false) @map("created_by_visitor")
  product    Product     @relation(fields: [productId], references: [id])
  inventory  Inventory[]
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@map("variants")
}

model Inventory {
  id        Uuid    @id @default(uuid())
  variantId Uuid    @map("variant_id")
  location  String
  quantity  Int     @default(0)
  reserved  Int     @default(0)
  isSample         Boolean @default(false) @map("is_sample")
  createdByVisitor Boolean @default(false) @map("created_by_visitor")
  variant   Variant @relation(fields: [variantId], references: [id])

  @@map("inventory")
}

model Address {
  id               Uuid    @id @default(uuid())
  userId           Uuid    @map("user_id")
  name             String
  line1            String
  city             String
  state            String
  pincode          String
  isDefault        Boolean @default(false) @map("is_default")
  createdByVisitor Boolean @default(false) @map("created_by_visitor")
  isSample         Boolean @default(false) @map("is_sample")
  user             User    @relation(fields: [userId], references: [id])
  orders           Order[]

  @@map("addresses")
}

model Coupon {
  id             Uuid     @id @default(uuid())
  code           String   @unique
  percentOff     Int?     @map("percent_off")
  amountOffPaise Int?     @map("amount_off_paise")
  validUntil     DateTime @map("valid_until")
  // How many orders may use the code; no limit when empty.
  maxUses        Int?     @map("max_uses")
  isSample       Boolean  @default(false) @map("is_sample")
  orders         Order[]

  @@map("coupons")
}

model Order {
  id               Uuid       @id @default(uuid())
  userId           Uuid       @map("user_id")
  addressId        Uuid       @map("address_id")
  couponId         Uuid?      @map("coupon_id")
  status           String
  totalPaise       Int        @map("total_paise")
  idempotencyKey   String     @unique @map("idempotency_key")
  createdByVisitor Boolean    @default(false) @map("created_by_visitor")
  isSample         Boolean @default(false) @map("is_sample")
  createdAt        DateTime   @default(now()) @map("created_at")
  user             User       @relation(fields: [userId], references: [id])
  address          Address    @relation(fields: [addressId], references: [id])
  coupon           Coupon?    @relation(fields: [couponId], references: [id])
  subOrders        SubOrder[]
  payment          Payment?

  @@map("orders")
}

model SubOrder {
  id            Uuid        @id @default(uuid())
  orderId       Uuid        @map("order_id")
  sellerId      Uuid        @map("seller_id")
  status        String
  subtotalPaise Int         @map("subtotal_paise")
  isSample         Boolean @default(false) @map("is_sample")
  createdByVisitor Boolean @default(false) @map("created_by_visitor")
  order         Order       @relation(fields: [orderId], references: [id])
  seller        Seller      @relation(fields: [sellerId], references: [id])
  items         OrderItem[]
  shipment      Shipment?

  @@map("sub_orders")
}

// One per sub-order: each seller ships their part on its own. The courier is simulated (Phase 9),
// so the tracking number is a made-up reference.
model Shipment {
  id               Uuid     @id @default(uuid())
  subOrderId       Uuid     @unique @map("sub_order_id")
  status           String
  trackingNumber   String?  @unique @map("tracking_number")
  isSample         Boolean  @default(false) @map("is_sample")
  createdByVisitor Boolean  @default(false) @map("created_by_visitor")
  createdAt        DateTime @default(now()) @map("created_at")
  subOrder         SubOrder @relation(fields: [subOrderId], references: [id])

  @@map("shipments")
}

model OrderItem {
  id             Uuid     @id @default(uuid())
  subOrderId     Uuid     @map("sub_order_id")
  variantId      Uuid     @map("variant_id")
  quantity       Int
  unitPricePaise Int      @map("unit_price_paise")
  isSample         Boolean @default(false) @map("is_sample")
  createdByVisitor Boolean @default(false) @map("created_by_visitor")
  subOrder       SubOrder @relation(fields: [subOrderId], references: [id])
  variant        Variant  @relation(fields: [variantId], references: [id])
  review         Review?

  @@map("order_items")
}

model Payment {
  id          Uuid     @id @default(uuid())
  orderId     Uuid     @unique @map("order_id")
  status      String
  amountPaise Int      @map("amount_paise")
  gatewayRef  String   @map("gateway_ref")
  isSample         Boolean @default(false) @map("is_sample")
  createdByVisitor Boolean @default(false) @map("created_by_visitor")
  createdAt   DateTime @default(now()) @map("created_at")
  order       Order    @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// A seller's earnings for one month, derived from their sub-orders. Simulated: no money moves.
// payout_paise = gross_paise - commission_paise.
model Settlement {
  id               Uuid     @id @default(uuid())
  sellerId         Uuid     @map("seller_id")
  periodStart      DateTime @map("period_start")
  grossPaise       Int      @map("gross_paise")
  commissionPaise  Int      @map("commission_paise")
  payoutPaise      Int      @map("payout_paise")
  status           String
  isSample         Boolean  @default(false) @map("is_sample")
  createdByVisitor Boolean  @default(false) @map("created_by_visitor")
  createdAt        DateTime @default(now()) @map("created_at")
  seller           Seller   @relation(fields: [sellerId], references: [id])

  @@unique([sellerId, periodStart])
  @@map("settlements")
}

model Review {
  id               Uuid      @id @default(uuid())
  orderItemId      Uuid      @unique @map("order_item_id")
  userId           Uuid      @map("user_id")
  productId        Uuid      @map("product_id")
  rating           Int
  body             String
  isSample         Boolean   @default(false) @map("is_sample")
  createdByVisitor Boolean   @default(false) @map("created_by_visitor")
  createdAt        DateTime  @default(now()) @map("created_at")
  orderItem        OrderItem @relation(fields: [orderItemId], references: [id])
  user             User      @relation(fields: [userId], references: [id])
  product          Product   @relation(fields: [productId], references: [id])

  @@index([productId, createdAt, id])
  @@map("reviews")
}

model AuditLog {
  id         Uuid     @id @default(uuid())
  actorId    Uuid?    @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   Uuid     @map("target_id")
  requestId  String   @map("request_id")
  isSample         Boolean @default(false) @map("is_sample")
  createdByVisitor Boolean @default(false) @map("created_by_visitor")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

model Cart {
  id               Uuid       @id @default(uuid())
  userId           Uuid       @unique @map("user_id")
  createdByVisitor Boolean    @default(false) @map("created_by_visitor")
  isSample         Boolean @default(false) @map("is_sample")
  user             User       @relation(fields: [userId], references: [id])
  items            CartItem[]

  @@map("carts")
}

model CartItem {
  id        Uuid    @id @default(uuid())
  cartId    Uuid    @map("cart_id")
  variantId Uuid    @map("variant_id")
  quantity  Int
  isSample         Boolean @default(false) @map("is_sample")
  createdByVisitor Boolean @default(false) @map("created_by_visitor")
  cart      Cart    @relation(fields: [cartId], references: [id])
  variant   Variant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// One row, written by the seed, marks a database as a demo one. The reset command refuses to run
// on a database without it.
model DemoMarker {
  id        Uuid     @id @default(uuid())
  name      String
  createdAt DateTime @map("created_at")

  @@map("_demo_marker")
}

model RefreshToken {
  id               Uuid      @id @default(uuid())
  userId           Uuid      @map("user_id")
  familyId         Uuid      @map("family_id")
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at")
  usedAt           DateTime? @map("used_at")
  revokedAt        DateTime? @map("revoked_at")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")
  isSample         Boolean   @default(false) @map("is_sample")
  createdByVisitor Boolean   @default(false) @map("created_by_visitor")
  user             User      @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
  @@index([familyId])
}
