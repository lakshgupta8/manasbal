    "execute": [
      {
        "description": "create table \"refresh_tokens\"",
        "sql": "CREATE TABLE \"public\".\"refresh_tokens\" (\n  \"created_at\" timestamptz DEFAULT (now()) NOT NULL,\n  \"created_by_visitor\" bool DEFAULT false NOT NULL,\n  \"expires_at\" timestamptz NOT NULL,\n  \"family_id\" uuid NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"is_sample\" bool DEFAULT false NOT NULL,\n  \"revoked_at\" timestamptz,\n  \"token_hash\" text NOT NULL,\n  \"used_at\" timestamptz,\n  \"user_agent\" text,\n  \"user_id\" uuid NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
    "postcheck": [
