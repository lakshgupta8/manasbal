DATABASE_URL=postgresql://manasbal:manasbal@localhost:5432/manasbal
REDIS_URL=redis://localhost:6379
# Signs access tokens. Any long random string locally; production's is set on Render.
JWT_SECRET=local-dev-only-change-me-0123456789abcdef
# smtp sends mail to SMTP_URL (Mailpit locally, see http://localhost:8025); off (or unset) sends none. Production uses off.
MAIL_MODE=smtp
# Where smtp mode sends mail: Mailpit from docker compose.
SMTP_URL=smtp://localhost:1025
# The storefront's address, used in links sent by email.
WEB_URL=http://localhost:3000
# Storefront (apps/web/.env.local): where the server-side pages reach the API.
API_URL=http://localhost:3001
