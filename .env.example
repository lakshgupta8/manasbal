DATABASE_URL=postgresql://manasbal:manasbal@localhost:5432/manasbal
REDIS_URL=redis://localhost:6379
# Signs access tokens. Any long random string locally; production's is set on Render.
JWT_SECRET=local-dev-only-change-me-0123456789abcdef
# Encrypts two-step sign-in secrets (AES-256-GCM): 32 random bytes, base64. This all-zero key is
# only a placeholder: make your own with
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"; production's is set on Render.
TOTP_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# smtp sends mail to SMTP_URL (Mailpit locally, see http://localhost:8025); off (or unset) sends none. Production uses off.
MAIL_MODE=smtp
# Where smtp mode sends mail: Mailpit from docker compose.
SMTP_URL=smtp://localhost:1025
# The storefront's address, used in links sent by email.
WEB_URL=http://localhost:3000
# The shop's origins (comma-separated, no trailing slash): the only sites a browser may call the
# API from with the refresh cookie (CORS, and the Origin check on /auth/refresh and /auth/sign-out).
# Production's is set on Render.
WEB_ORIGINS=http://localhost:3000,http://localhost:5173
# Storefront (apps/web/.env.local): where the server-side pages reach the API.
API_URL=http://localhost:3001
