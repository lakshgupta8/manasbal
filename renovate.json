{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    ":maintainLockFilesWeekly",
    "docker:pinDigests"
  ],
  "timezone": "Asia/Kolkata",
  "schedule": ["before 9am on monday"],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Keep TypeScript on 6.0 until typescript-eslint and the Nest CLI support 7 (ADR 0005)",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1"
    },
    {
      "description": "One weekly PR for non-major dev-tool updates",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev tooling (non-major)"
    },
    {
      "description": "One weekly PR for GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "NestJS packages move together",
      "matchPackageNames": ["@nestjs/**"],
      "groupName": "NestJS"
    },
    {
      "description": "React and its types move together",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "React"
    }
  ]
}
