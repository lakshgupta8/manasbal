{
  "name": "manasbal",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:e2e": "turbo run test:e2e",
    "test:visual": "pnpm --filter @manasbal/ui test:visual",
    "api-types": "pnpm turbo run build --filter=@manasbal/api && pnpm --filter @manasbal/api openapi && pnpm --filter @manasbal/types generate",
    "check:brands": "node scripts/check-brands.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "size": "size-limit",
    "lighthouse": "pnpm dlx @lhci/cli@0.15.1 autorun"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@size-limit/file": "^14.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "size-limit": "^14.2.0",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,css,html,yml,yaml}": "prettier --write"
  }
}
